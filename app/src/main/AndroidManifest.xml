<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fase 0 nao captura audio: quem grava e o Zello. O app so envia
         os broadcasts de PTT documentados pela Zello. A declaracao
         <queries> permite conferir se o Zello esta instalado (Android 11+).
         POST_NOTIFICATIONS: a notificacao de transmissao carrega o botao
         "Encerrar", usado com o Zello na frente. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.loudtalks" />
        <package android:name="net.loudtalks" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DxPtt">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".PttActionReceiver"
            android:exported="false" />

        <!-- Companheiro do relogio: recebe "apertou/soltou" pela Data
             Layer e repassa para o PttSender. O Google Play services
             acorda este servico quando a mensagem chega. -->
        <service
            android:name=".PttMessageService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/ptt"
                    android:scheme="wear" />
            </intent-filter>
        </service>

    </application>

</manifest>
